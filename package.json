{
  "name": "paghi-tu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run ingest:build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "data:import": "node scripts/data/import-research.ts",
    "data:fetch": "node scripts/data/fetch-public-finance.ts",
    "data:finance": "node scripts/data/build-public-finance.ts",
    "data:update": "npm run data:fetch && npm run data:finance",
    "data:archive": "node scripts/data/archive-sources.ts",
    "notify": "node scripts/notify.ts",
    "check:pages": "node scripts/check-pages.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "evals:build": "node agent/evals/build.ts",
    "evals:verify": "node agent/evals/verifica-fonti.ts",
    "ingest:build": "node agent/ingest/build.ts",
    "agent:preview:plan": "node scripts/agent/setup-preview.mjs",
    "agent:preview:verify": "node scripts/agent/verify-preview.mjs",
    "agent:preview:control": "node --conditions=react-server scripts/agent/control-preview.mjs",
    "agent:stress:http": "node scripts/agent/stress-preview.mjs",
    "agent:stress:state": "node --conditions=react-server scripts/agent/stress-state.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "2.0.1",
    "@vercel/oidc": "4.0.5",
    "google-auth-library": "11.3.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  },
  "license": "MIT",
  "type": "module"
}
